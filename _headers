/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://www.google.com; connect-src 'self'; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Le cache par défaut de Cloudflare Pages (4h) sur les .js/.css a caché une version cassée
# de main.js le temps que le correctif se propage (2026-08-31). On force la revalidation
# systématique (ETag) pour que chaque modification soit visible immédiatement.
/assets/js/main.js
  Cache-Control: no-cache

/assets/js/inscription.js
  Cache-Control: no-cache

/assets/css/styles.css
  Cache-Control: no-cache
