/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://www.google.com; connect-src 'self'; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Note (2026-08-31) : Cloudflare Pages ignore les règles _headers plus spécifiques que /*
# pour les assets statiques (Cache-Control notamment, mais aussi tout header custom testé —
# vérifié en direct par déploiement). Le cache 4h sur assets/js/*.js et assets/css/*.css est
# donc géré via un paramètre de version dans l'URL (?v=...) sur les <script>/<link> des pages
# HTML plutôt que via ce fichier — voir CLAUDE.md.
